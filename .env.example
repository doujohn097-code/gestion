# Firebase (client config - these are safe to expose in the built app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: Firebase Cloud Messaging VAPID key for web push
VITE_FIREBASE_VAPID_KEY=
VITE_VAPID_PUBLIC_KEY=

# Optional: override the API base in dev. Leave empty on Vercel.
VITE_API_BASE=

# Web Push VAPID keys (server-side, for api/notify.js)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Cloudflare R2 (server-side, for api/presign.js)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public URL for the R2 bucket, e.g. https://pub-xxxxxxxx.r2.dev
# The bucket must have public access / r2.dev URL enabled in Cloudflare dashboard.
R2_PUBLIC_URL=

# Optional: Cloudflare API token with R2 edit permission.
# If provided, the build script will try to enable the r2.dev public URL automatically.
CLOUDFLARE_API_TOKEN=

# Firebase Admin service account key, base64-encoded JSON.
# Used by api/notify.js for push notifications.
FIREBASE_ADMIN_KEY=
